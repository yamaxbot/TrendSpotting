# Copy to .env and supply the API keys for new searches and article summaries.
OPENALEX_API_KEY=
KIE_API_KEY=

# Local demo defaults. Set DJANGO_DEBUG=0 and a strong key before external access.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
HOST_BIND=127.0.0.1
PORT=8000
